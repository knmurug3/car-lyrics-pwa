{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "functions": {
    "api/library.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/library?action=cron",
      "schedule": "0 10 * * *"
    }
  ]
}
